# =====================================================================
# JobGuard AI - Apache Configuration & Security Rules
# =====================================================================

Options -Indexes
Options +FollowSymLinks

# Deny access to .env and hidden files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable CORS headers if mod_headers is available
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept"
</IfModule>

